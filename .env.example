# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"

# APP_URL: the URL this app is hosted at (self-referential links, e.g. shared
# post previews). AI Studio injects this automatically when deployed there.
APP_URL="http://localhost:3000"

# FRONTEND_URL: only needed if the frontend is ever hosted on a different
# origin than this server (uncommon — this is a single unified app). Leave
# unset for same-origin deployments; it defaults to "*" (no credentials).
# FRONTEND_URL="https://your-domain.com"

# ── Database (required) ──────────────────────────────────────────────────
# Postgres connection string — e.g. a free Neon or Supabase instance.
# Do NOT commit real credentials.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# ── Auth (required) ───────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-string"

# ── AI (routes/ai.js — ScottyAI chat, writer, code, logo, etc. tools) ─────
OPENROUTER_API_KEY=""

# ── Bot Generator file storage (routes/botgen.js) ────────────────────────
# Optional — without these, generated bot zips fall back to local disk
# storage under dist/public/generated-bots (not persistent across restarts
# on most hosts, so S3-compatible storage is recommended for production).
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""

# ── Email (routes/auth.js — verification & password reset emails) ────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ScottyHub <no-reply@scottyhub.co.zw>"

# ── Web Push (routes/push.js) ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@scottyhub.co.zw"
